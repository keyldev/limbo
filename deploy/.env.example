# Скопируйте в deploy/.env и заполните. Сам .env в git не попадает.
POSTGRES_PASSWORD=change-me

# Домен фронта: туда открыта CORS-политика API.
WEB_ORIGIN=https://example.com

# compose.yaml (свой Caddy на 80/443): домен API.
API_DOMAIN=api.example.com

# compose.behind-proxy.yaml (прокси уже стоит на машине): внешняя сеть прокси.
PROXY_NETWORK=edge
