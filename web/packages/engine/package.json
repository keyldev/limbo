{
  "name": "@loadline/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Движок симуляции Loadline. Чистый TypeScript: без Angular и без DOM, работает в Web Worker, Node и CI.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@loadline/model": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
